 "blooms_taxonomy": {
  "scheme": "Revised Bloom's taxonomy (Anderson and Krathwohl).",
  "why_both": "The assessment objective says what the examination credits. The Bloom level says what the learner is asked to do. Every item carries both.",
  "levels": [
   {
    "level": "Remember",
    "means": "Recall a fact, term or list as stated."
   },
   {
    "level": "Understand",
    "means": "Explain an idea in the learner's own words, or tell it apart from a neighbouring one."
   },
   {
    "level": "Apply",
    "means": "Use the idea on a case, figure, diagram or specimen the learner has not been given the answer to."
   },
   {
    "level": "Analyse",
    "means": "Break a situation into parts and trace a cause through to its consequence."
   },
   {
    "level": "Evaluate",
    "means": "Weigh options against a criterion and reach a justified decision."
   },
   {
    "level": "Create",
    "means": "Build something new from two or more ideas."
   }
  ],
